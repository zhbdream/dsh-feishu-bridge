# Local env template (optional)

# Prefer profile cordis.patch.yml for real use. Do NOT commit real secrets.
# Copy values into your shell or a gitignored .env loader — this file is a checklist only.

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOW_OPEN_IDS=
DSH_WORKSPACE=
FEISHU_TASK_TIMEOUT_MS=600000

# Optional deny extras (merged with built-in bash/write/edit/…)
# FEISHU_DENY_TOOLS=
# FEISHU_DENY_TOOL_PREFIXES=

# Unsafe: skip built-in dangerous defaults
# FEISHU_ALLOW_DANGEROUS_TOOLS=0

# Fallback model if agentDefaultModel is unavailable
# DSH_PROVIDER=
# DSH_MODEL=
